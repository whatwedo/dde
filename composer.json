{
    "name": "whatwedo/dde",
    "description": "Docker Development Environment CLI",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.5.3",
        "symfony/clock": "^8.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/process": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/string": "^8.0",
        "symfony/translation-contracts": "^3.6",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0",
        "symfony/serializer-pack": "^1.4",
        "whatwedo/php-coding-standard": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/runtime": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
