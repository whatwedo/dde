{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": [
    "v2"
  ],
  "schedule": ["at any time"],
  "timezone": "Europe/Zurich",
  "labels": ["dependencies"],
  "minimumReleaseAge": "4 days",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Group and automerge all minor and patch updates when CI passes",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "description": "Separate non-Symfony major updates — one PR per package for manual review",
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Group and automerge Symfony minor/patch updates together",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "symfony",
      "groupSlug": "symfony",
      "automerge": true,
      "matchPackageNames": [
        "symfony/{/,}**"
      ]
    },
    {
      "description": "Group Symfony major updates into their own PR — updated as a set, manual review (no automerge)",
      "matchUpdateTypes": ["major"],
      "groupName": "symfony (major)",
      "groupSlug": "symfony-major",
      "matchPackageNames": [
        "symfony/{/,}**"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security"]
  }
}
